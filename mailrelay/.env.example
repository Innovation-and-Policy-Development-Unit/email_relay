# Copy to .env and adjust. Never commit the real .env (dkim-keys/ holds the actual private key material).

# Domain mail will be sent FROM. Django's DEFAULT_FROM_EMAIL should be something@this domain.
MAIL_DOMAIN=psc.gov.vu

# Hostname Postfix announces in HELO/EHLO and in the Received header.
# In production this MUST match the PTR (reverse DNS) record of the server's public IP,
# e.g. mail.psc.gov.vu -> A -> 1.2.3.4, and 1.2.3.4 -> PTR -> mail.psc.gov.vu.
MAIL_HOSTNAME=mail.psc.gov.vu

# DKIM selector -> the DNS record will live at <selector>._domainkey.<MAIL_DOMAIN>
DKIM_SELECTOR=mail

# Comma/space separated list of domains this relay is allowed to send mail FROM.
# Keep this locked down to your real sending domain(s) to avoid becoming an open relay
# if mynetworks is ever misconfigured.
ALLOWED_SENDER_DOMAINS=psc.gov.vu
